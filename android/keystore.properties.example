# Template for signing configuration
# DO NOT COMMIT your real keystore.properties or keystore files to source control!
# Copy this file to android/keystore.properties (which is gitignored) and fill in your values.
#
# Alternatively, configure environment variables:
# KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD

storeFile=release.keystore
storePassword=CHANGE_ME_KEYSTORE_PASSWORD
keyAlias=chromastudio
keyPassword=CHANGE_ME_KEY_PASSWORD
